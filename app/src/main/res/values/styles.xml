<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Button styles -->
    <style name="Widget.Aegis.Button" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <style name="Widget.Aegis.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/md_theme_primary</item>
    </style>

    <style name="Widget.Aegis.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
    </style>

    <!-- Card styles -->
    <style name="Widget.Aegis.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:layout_margin">@dimen/spacing_sm</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="cardBackgroundColor">@color/surface_elevated</item>
    </style>

    <style name="Widget.Aegis.Card.Header" parent="Widget.Aegis.Card">
        <item name="cardBackgroundColor">@color/md_theme_primaryContainer</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.Aegis.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Aegis.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Aegis.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Aegis.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Aegis.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Aegis.Status.Active">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/status_active</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Aegis.Status.Idle">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/status_idle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Aegis.Status.Alert">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/status_alert</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Spinner style -->
    <style name="Widget.Aegis.Spinner" parent="Widget.Material3.MaterialTimePicker.Display">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:paddingHorizontal">@dimen/spacing_md</item>
    </style>

    <!-- Progress bar style -->
    <style name="Widget.Aegis.ProgressBar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="android:layout_height">@dimen/progress_bar_height</item>
        <item name="trackCornerRadius">@dimen/progress_bar_corner</item>
        <item name="indicatorColor">@color/md_theme_primary</item>
        <item name="trackColor">@color/md_theme_surfaceVariant</item>
    </style>
</resources>